#pragma once
// WiFi credentials are loaded from wifi.txt on the SD card at boot.
// This file is intentionally left empty.
//
// To configure WiFi:
//   1. Create a file called wifi.txt on your SD card
//   2. Line 1: your WiFi network name (SSID)
//   3. Line 2: your WiFi password
//   4. Insert the SD card and power on — credentials are saved automatically
//   5. Remove the SD card (no longer needed after first boot)
